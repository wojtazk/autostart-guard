    <!--
      Musi wskazywac wersje SDK, dla ktorej zainstalowany jest WDK, czyli taka,
      ktora ma katalogi Include\<wersja>\km i build\<wersja>. Bez tego
      WindowsTargetPlatformVersion rozwija sie do samego "10.0", KM_IncludePath
      zostaje puste i plik kompiluje sie naglowkami user mode - ntddk.h nie
      zostanie znaleziony.

      Sprawdzenie, co jest na danej maszynie:
        Get-ChildItem "${env:ProgramFiles(x86)}\Windows Kits\10\build"
    -->
    <WindowsTargetPlatformVersion Condition="'$(WindowsTargetPlatformVersion)' == ''">10.0.22621.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
