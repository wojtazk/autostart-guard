  <!--
    PsSetCreateProcessNotifyRoutineEx wymaga flagi IMAGE_DLLCHARACTERISTICS_FORCE_INTEGRITY
    w naglowku PE. Bez /INTEGRITYCHECK rejestracja callbacku konczy sie
    STATUS_ACCESS_DENIED (0xC0000022).
  -->
  <ItemDefinitionGroup>
    <Link>
      <AdditionalOptions>%(AdditionalOptions) /INTEGRITYCHECK</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>
  <!--
    Brak pliku INF celowo. To driver niePnP (software-only), ktory nie
    podlacza sie pod zadne urzadzenie - instalujemy go jako usluge jadra
    przez "sc create". INF w tym projekcie powodowal blad InfVerif 1297
    ("does not install on any devices").
  -->
  <ItemGroup>
    <ClInclude Include="agctl.h" />
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="driver.c" />
  </ItemGroup>
  <ItemGroup>
    <FilesToPackage Include="$(TargetPath)" />
  </ItemGroup>
